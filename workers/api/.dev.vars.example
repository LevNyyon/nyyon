# Copy to .dev.vars (gitignored) and fill.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# WA_API_KEY=      # generated by `npm run setup`, shared with services/whatsapp
# LI_API_KEY=      # your linkedin-gateway's X-API-Key

# ── Auth gate (src/gate.js) — protects the whole online deployment ──
# Set these as Cloudflare secrets in production (`wrangler secret put NAME`),
# NOT committed. The login page checks GATE_USER + GATE_PASSWORD; sessions are
# HMAC-signed with GATE_SECRET. Rate limit: 3 failed attempts / hour / IP.
GATE_USER=you@example.com
GATE_PASSWORD=change-me
GATE_SECRET=long-random-string-for-cookie-signing
