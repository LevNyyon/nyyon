// Root config for Cloudflare's "Deploy to Workers" button.
//
// The button reads wrangler config from the REPO ROOT and runs the build and
// deploy from there, so this file exists for that path alone. It mirrors
// workers/api/wrangler.jsonc with root-relative paths, and it deliberately
// carries NO database_id: on a one-click deploy Cloudflare creates the D1
// database and the bucket in the visitor's own account and binds them.
//
// The everyday local and CI paths still use workers/api/wrangler.jsonc.
{
  "name": "nyyon",
  "main": "workers/api/src/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The worker's own dependencies (hono and friends) live in workers/api, and
  // a root deploy resolves imports from the root, so they must be installed
  // too. Without this the bundle fails on `import { cors } from 'hono/cors'`
  // and the one-click deploy dies before it starts.
  "build": {
    "command": "npm install && npm --prefix workers/api install && npm --prefix web install && npm --prefix web run build"
  },

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "nyyon" }
  ],


  // Only what a fresh install cannot derive. The model tiers live in the
  // llm-models knowledge doc and have code defaults; the API key is set in
  // Settings after the first sign-in; the gate secret is minted per install.
  // Empty placeholders for services this build does not ship (WhatsApp,
  // website, assets) are worse than absent: they read as configuration.
  "vars": {},

  "triggers": { "crons": ["0 * * * *", "45 * * * *", "0 6 * * *"] },

  "assets": {
    "directory": "web/dist",
    "binding": "STATIC",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
